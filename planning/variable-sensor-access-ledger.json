{
  "schema_version": "sensor-access-ledger-v0",
  "accepted_date": "2026-07-24",
  "baseline": {
    "id": "baseline-oracle-v0",
    "observation_mode": "oracle_material_state",
    "sensor_equivalent": false,
    "allowed_uses": [
      "native process and controller development",
      "transition-learning smoke tests",
      "active-inference equation tests under declared oracle observations",
      "matched oracle comparator for later sensor-equivalent experiments",
      "visualization and simulator-only evaluation"
    ],
    "prohibited_claims": [
      "sensor-only state inference",
      "physical deployability",
      "calibrated camera or contact perception",
      "learning exclusively from physically available sensory history",
      "embodied prediction without simulator-state leakage"
    ]
  },
  "classifications": {
    "physical_sensor_observation": "A simulated value with a direct planned hardware sensor analogue. It is not necessarily assimilated by the current agent.",
    "derived_observation": "A deterministic or statistical transform of observations or process state. Derivation from hidden process truth does not make it sensor-equivalent.",
    "hidden_state": "A generative-process state or parameter that the physical agent cannot read directly.",
    "simulator_only_evaluation_label": "Process truth retained only for rendering, debugging, scoring, calibration assessment, or failure analysis.",
    "execution_only_state": "Commands, calibrated geometry, controller state, or hard-safety state below painting-policy selection."
  },
