          data="canvas_plane_homography canvas_plane_homography"/>
    <text name="sensor_camera_hardware_baseline"
          data="Raspberry_Pi_Global_Shutter_Camera_IMX296 Raspberry_Pi_Global_Shutter_Camera_IMX296"/>
    <text name="sensor_camera_hardware_status"
          data="selected_not_purchased selected_not_purchased"/>
    <text name="sensor_camera_lens_status"
