    <numeric name="sensor_camera_read_noise_std"
             data="0.004 0.004"/>
    <numeric name="sensor_camera_signal_noise_std"
             data="0.008 0.008"/>
    <!-- Likelihood uncertainty is deliberately wider than the acquisition-
         noise term. It includes unmodeled photometry/registration. The
         inlier prior is a latent occlusion probability, not a visibility mask. -->
    <numeric name="sensor_camera_likelihood_model_error_std"
             data="0.040 0.040"/>
    <numeric name="sensor_camera_likelihood_inlier_probability"
             data="0.950 0.950"/>
    <numeric name="sensor_camera_likelihood_outlier_std"
             data="0.350 0.350"/>
    <numeric name="sensor_camera_latency_s"
             data="0.016666666667 0.016666666667"/>
