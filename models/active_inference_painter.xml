    <numeric name="robstride_model_peak_current_a"
             data="25.776300208208 25.776300208208 14.808568229121 14.808568229121"/>
    <!-- These voltage-space gains preserve the prior approximate joint-space
         stiffness/damping. They are not claimed RobStride firmware gains. -->
    <numeric name="robstride_controller_kp_v_per_rad"
             data="168 208 240 352.941176470588"/>
    <numeric name="robstride_controller_kd_vs_per_rad"
             data="13.644706652048 16.844706652048 18.596836435874 27.067424671168"/>
