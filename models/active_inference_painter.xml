    <numeric name="brush_tangential_stiffness_nm_per_rad" data="1.2 1.2"/>
    <numeric name="brush_tangential_damping_nms_per_rad" data="0.01 0.01"/>
    <numeric name="robstride_rated_torque_nm" data="20 20 6 6"/>
    <numeric name="robstride_peak_torque_nm" data="60 60 17 17"/>
    <numeric name="robstride_mass_kg" data="0.880 0.880 0.405 0.405"/>
    <numeric name="robstride_reduction_ratio" data="9 9 7.75 7.75"/>
    <numeric name="robstride_rated_voltage_v" data="48 48 48 48"/>
    <numeric name="robstride_voltage_min_v" data="15 15 24 24"/>
    <numeric name="robstride_voltage_max_v" data="60 60 60 60"/>
    <numeric name="robstride_rated_power_w" data="380 380 170 170"/>
    <numeric name="robstride_rated_speed_rad_s"
             data="10.471975511966 10.471975511966 10.471975511966 10.471975511966"/>
    <numeric name="robstride_no_load_speed_rad_s"
             data="20.420352248333 20.420352248333 42.935099858269 42.935099858269"/>
    <numeric name="robstride_rated_phase_current_apk" data="12 12 7 7"/>
    <numeric name="robstride_peak_phase_current_apk" data="43 43 23 23"/>
    <numeric name="robstride_torque_constant_nm_per_arms"
             data="2.36 2.36 1.22 1.22"/>
    <!-- Ke, output-equivalent R, and viscous loss are jointly derived so the
         DC model passes through the published no-load speed/current point and
         the 48 V peak-torque stall point. MuJoCo uses sqrt(Kt*Ke). -->
    <numeric name="robstride_back_emf_constant_vs_per_rad"
             data="2.295880796136 2.295880796136 1.080219146592 1.080219146592"/>
    <numeric name="robstride_effective_motor_constant_nm_per_a"
             data="2.327719630643 2.327719630643 1.147984041196 1.147984041196"/>
    <!-- Equivalent output-side R is selected so 48 V at zero speed reaches
         the specified peak output torque. It is not raw phase resistance. -->
    <numeric name="robstride_equivalent_terminal_resistance_ohm"
             data="1.862175704515 1.862175704515 3.241366704555 3.241366704555"/>
    <numeric name="robstride_equivalent_viscous_loss_nms_per_rad"
             data="0.068394108064 0.068394108064 0.013368829372 0.013368829372"/>
    <numeric name="robstride_line_resistance_ohm" data="0.39 0.39 0.58 0.58"/>
    <numeric name="robstride_line_inductance_h"
             data="0.000275 0.000275 0.000263 0.000263"/>
    <numeric name="robstride_electrical_time_constant_s"
             data="0.000705128205 0.000705128205 0.000453448276 0.000453448276"/>
