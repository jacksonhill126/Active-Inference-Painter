    <numeric name="sensor_camera_model_resolution_px"
             data="512 512 512 512"/>
    <numeric name="sensor_camera_acquisition_resolution_px"
             data="1456 1088 1456 1088"/>
    <numeric name="sensor_camera_foveal_resolution_px"
             data="256 256 256 256"/>
    <!-- IMX296 active dimensions use the declared 1456 x 1088 array and
         3.45 um pixel pitch. The provisional 4 mm CS lens must be replaced by
         the selected lens' measured intrinsics after purchase/calibration. -->
