    <numeric name="sensor_camera_quantization_bits" data="10 10"/>
    <numeric name="camera_provisional_specular_strength" data="0.08"/>
    <numeric name="joint_range_rad"
             data="-1.570796326795 1.570796326795 -1.570796326795 1.570796326795 -3.141592653590 3.141592653590 -1.483529864195 2.617993877991"/>
    <numeric name="native_controller_joint_range_rad"
             data="-1.570796326795 1.570796326795 -1.570796326795 1.570796326795 -3.141592653590 3.141592653590 0 2.617993877991"/>
    <numeric name="safe_home_qpos_rad"
             data="0 -0.872664625997 0 1.745329251994 0 0 0"/>
    <numeric name="camera_clear_park_qpos_rad"
             data="0 -1.334725703904 0 1.413674247728 0 0 0"/>
    <numeric name="link_length_m" data="0.3302 0.3302"/>
    <numeric name="post_yaw_height_m" data="0.285"/>
    <numeric name="yaw_to_pitch_offset_m" data="0.075 0 0.106"/>
    <numeric name="yaw_to_pitch_distance_m" data="0.129849913362"/>
    <numeric name="pitch_to_roll_offset_m" data="0.083"/>
    <numeric name="canvas_size_m" data="0.508 0.508"/>
    <numeric name="native_canvas_contact_y_m" data="0.4318"/>
    <numeric name="canvas_contact_y_m" data="0.4826"/>
    <numeric name="canvas_center_x_m" data="0.075"/>
